# Copy this file to .env and fill in your Alpaca Markets API credentials.
# Free, no funding required: https://alpaca.markets/ -> Sign Up -> Paper Trading -> API Keys.
#
# IMPORTANT: use feed=sip, not iex, for this project. The free IEX feed only reflects
# trades executed on the IEX exchange -- verified during development that it captures
# roughly 2% of real volume for a liquid mega-cap name (META, 2024-06-03: 193,856 IEX
# shares vs. 10,843,911 SIP/consolidated shares), and silently drops a large fraction
# of trading days entirely for less-IEX-active symbols. Since this strategy's core
# variable is relative TRADING VOLUME, IEX-only data would invalidate the analysis.
# SIP access has historically required a paid plan, but Alpaca has extended free SIP
# access to many accounts -- confirmed working here on a free/paper account. If your
# account errors on feed=sip, you do not have SIP access and results computed on IEX
# volume must be treated as unreliable for anything volume-related.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# "iex" or "sip" -- see note above. Default: sip
ALPACA_DATA_FEED=sip
